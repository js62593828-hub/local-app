{
  "_설명": "W싼세계(wp_tips) 원고 '피할 표현' 규칙. tools/wp_rules.md 12장(피할 표현)·4장·6장의 말을 기계가 셀 수 있게 옮긴 것. tools/wp_check.py 가 읽는다. 정규식은 한 줄 안에서 찾는다. severity: fail = 위반(0개여야 함), warn = 사람이 판단(위반으로 세지 않음).",
  "zero": [
    {"name": "갈리다 계열", "severity": "fail",
     "regex": "(?<!헷)갈(?:리|린|려|립|릴|렸)|가르(?![치쳐])|가른|가릅",
     "hint": "갈린다 → 달라져요 / 차이가 나요 / ~에 달려 있어요 / 나뉘어요"},
    {"name": "~다는 점이 가장 큰", "severity": "fail", "regex": "점이\\s*가장\\s*큰", "hint": "가장 크게 다른 건 / 가장 눈에 띄는 건"},
    {"name": "쓸모", "severity": "fail", "regex": "쓸모", "hint": "쓰임 / 도움"},
    {"name": "구조예요/구조입니다", "severity": "fail", "regex": "구조(?:예요|입니다)", "hint": "방식이에요 / 형태예요"},
    {"name": "지점", "severity": "fail", "regex": "지점", "hint": "장소 뜻이 아니면 부분 / 곳 / 때"},
    {"name": "정답", "severity": "fail", "regex": "정답", "hint": "맞는 선택 / 잘 맞는 쪽"},
    {"name": "마주하게", "severity": "fail", "regex": "마주하게", "hint": "만나게 / 겪게"},
    {"name": "열리다(서비스)", "severity": "warn", "regex": "열리(?:는|며|고|면|죠|ㄴ)|열렸", "hint": "서비스가 '열리다'면 '시작되다'로. 문 여는 뜻이면 괜찮음"}
  ],
  "limits": [
    {"name": "핵심", "regex": "핵심", "max": 1},
    {"name": "셈이에요/셈입니다/셈이죠", "regex": "셈(?:이에요|입니다|이죠)", "max": 1},
    {"name": "~게 좋아요", "regex": "게\\s*좋(?:아요|습니다)|것이\\s*좋습니다", "max": 2},
    {"name": "통해", "regex": "통해", "max": 1},
    {"name": "에 따라 달라", "regex": "에\\s*따라\\s*달라", "max": 2}
  ],
  "forbidden": [
    {"name": "와우·쿠폰가·카드 할인가", "regex": "와우|쿠폰\\s*(?:적용)?가|쿠폰\\s*적용|카드\\s*할인", "chapter": "4"},
    {"name": "할인율", "regex": "할인율|\\d+\\s*%\\s*(?:할인|OFF|off|세일)", "chapter": "4"},
    {"name": "최저가 표현", "regex": "최저가|역대\\s*최저|지금이\\s*제일\\s*싸", "chapter": "4"},
    {"name": "판매량", "regex": "판매량|많이\\s*팔린|베스트\\s*셀러", "chapter": "4"},
    {"name": "대가성 문구(앱이 넣음)", "regex": "파트너스\\s*활동|수수료를\\s*제공", "chapter": "4"},
    {"name": "과장 표현", "regex": "최고|무조건|100\\s*%|완벽|역대급|강력\\s*추천", "chapter": "6"},
    {"name": "자료 부족을 말하는 문장(v1.4 7장)", "regex": "후기가\\s*적어|후기\\s*비율\\s*대신|표본이\\s*모이지|분량이\\s*모이지|후기로\\s*판단하기\\s*어려|사양을\\s*기준으로\\s*판단했", "chapter": "7"},
    {"name": "가격 압박", "regex": "할인\\s*곧|오늘만|마감\\s*임박|서두르세요", "chapter": "6"}
  ],
  "forbidden_warn": [
    {"name": "순위 표현(출처·세어 본 결과인지 사람이 확인)", "regex": "1위|순위|TOP\\s*\\d+", "chapter": "6"}
  ],
  "sounds_used": [
    {"name": "써 본 척 표현", "regex": "써\\s?보니|써\\s?봤|직접\\s*사용|직접\\s*써|실사용|사용기|내돈내산|\\d+\\s*(?:일|주|개월)\\s*(?:간\\s*)?(?:써|사용)|솔직\\s*후기"}
  ],
  "title_banned": ["내돈내산", "써보니", "써 보니", "사용기", "실사용", "솔직 후기", "솔직후기", "직접 써", "최저가", "최고", "무조건", "100%", "완벽", "강력 추천", "1위", "총정리", "역대급"],
  "title_banned_regex": ["TOP\\s*\\d+", "\\d[\\d,]*\\s*원"]
}
